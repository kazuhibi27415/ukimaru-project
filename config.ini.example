; ============================================================================
; PavlokSuperChat 設定ファイル
; ============================================================================
; 基本的に「★」が付いた項目だけ設定すれば使えます。
;
; 重要:
;   ・このファイルには APIキー / Pavlokトークン が入ります。
;   ・他人に渡したり、SNS / GitHub などへ公開しないでください。
;   ・「=」の右側だけ変更してください。
; ============================================================================


[YouTube]
; ★ YouTube Data API v3 の APIキー
; 例: api_key=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
; Bearer は付けません。
api_key=PASTE_YOUTUBE_API_KEY_HERE


[SuperChat]
; ★ Zapを発生させるスパチャ金額（円）
; 複数指定するときは半角カンマ「,」で区切ります。
; 金額は完全一致です。
;
; 下の例:
;   200円   -> 対象
;   500円   -> 対象
;   1000円  -> 対象
;   800円   -> 対象外
;
; JPY（日本円）の Super Chat のみ対象です。
; Super Sticker は対象外です。
amounts=200,500,1000,3000,5000


[Pavlok]
; ★ Pavlok の初期トークン
; Pavlok API の Getting Started で取得した値を貼り付けます。
; 「Bearer 」付きでも、JWT本体だけでも使用できます。
;
; 例:
; initial_token=Bearer eyJhbGciOiJIUzI1NiIs...
; または
; initial_token=eyJhbGciOiJIUzI1NiIs...
initial_token=PASTE_PAVLOK_INITIAL_TOKEN_HERE


; ★ Pavlokへ実際にZapを送るか
;
; false = テストモード（Zapは送信しない）
; true  = 実送信
;
; 最初は false のまま動作確認することをおすすめします。
enabled=false


; ★ スパチャ検出からZapまでの待ち時間（秒）
;
; 例:
; delay_seconds=0   -> すぐに実行
; delay_seconds=5   -> 5秒後に実行
; delay_seconds=10  -> 10秒後に実行
delay_seconds=5


; ★ 1回Zapした後、次のZapまで最低何秒あけるか
;
; この待ち時間中に対象スパチャが来ても捨てません。
; 予約キューに入り、順番に後から実行されます。
;
; 0 にするとクールダウンなしです。
cooldown_seconds=10


; ★ 出力方法
;
; fixed  = 毎回同じ強さ
; random = 指定範囲から毎回ランダム
output_mode=random


; fixed のときだけ使用する出力値（1～100）
; output_mode=random の場合、この値は使いません。
fixed_output=30


; random のときだけ使用する最小値 / 最大値（1～100）
; 両端の値を含みます。
; 例: 20～40 のどれかを送信直前に選択します。
random_min=20
random_max=40


[System]
; ---------------------------------------------------------------------------
; 通常は変更しなくてOKです。
; ---------------------------------------------------------------------------

; 起動直後に取得した「起動前のチャット履歴」を無視する設定
; true のまま推奨です。
ignore_initial_history=true
